# Backend Configuration Template
# Copy this to your infrastructure repository's providers.tf

terraform {
  required_version = ">= 1.6"

  backend "azurerm" {
    # Backend configuration will be provided via -backend-config flag
    # Create backend/<env>.tfbackend files with the following structure:
    # resource_group_name  = "rg-tfstate"
    # storage_account_name = "your-storage-account-name"
    # container_name       = "your-repo-container"
    # key                  = "<env>.tfstate"
    # use_oidc             = true
  }

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.117"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 2.50"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "azurerm" {
  features {}
  tenant_id       = var.tenant_id
  subscription_id = var.subscription_id
}

provider "azuread" {
  tenant_id = var.tenant_id
}